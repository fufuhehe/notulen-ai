        "url": "={{ $('Webhook').first().json.body.supa_url }}/rest/v1/kosakata?select=istilah&pemilik=eq.{{ $json.pemilik }}&jenis=in.(semua,{{ encodeURIComponent($json.jenis || 'rapat') }})",
